# shellcheck disable=SC2148

set -euo pipefail

main() {
  [ "$3" -eq 0 ] && exit 0

  # Switch to the Node version in .nvmrc when nvm is installed. It usually
  # isn't on Windows, and calling it anyway made every branch switch exit 127.
  export NVM_DIR="$HOME/.nvm"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    \. "$NVM_DIR/nvm.sh"
    nvm i
  fi

  npm i
}

main "$@"
