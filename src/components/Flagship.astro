---
import Icon from '@/components/Icon.astro';
import ProjectStats from '@/components/ProjectStats.astro';
import { type ProjectView, visibleTags } from '@/lib/projects';

interface Props {
  project: ProjectView;
}

const { project } = Astro.props;
const { video } = project;
const themes = ['light', 'dark'] as const;
---

<article class="flagship">
  <div class="flagship__body">
    <h3 class="flagship__title">{project.title}</h3>
    <ProjectStats project={project} />
    <p class="flagship__summary">{project.summary}</p>
    {project.highlights && (
      <ul class="flagship__highlights">
        {project.highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )}
    <ul class="tags" aria-label="Topics">
      {visibleTags(project.tags).map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
    <div class="flagship__actions">
      {project.links?.map(({ label, href }, index) => (
        <a
          class:list={['button', index === 0 && 'button--primary']}
          href={href}
          rel="noopener"
        >
          {label}
          <Icon name="external" />
        </a>
      ))}
      <a class="button" href={project.url} rel="noopener">
        <Icon name="github" />
        Source
      </a>
    </div>
  </div>
  {video ? (
    // One recording per theme, stacked; CSS shows the one for the current
    // theme. Files are attached by scripts/demo.ts only when needed.
    <figure class="flagship__media demo" data-demo>
      {themes.map((theme) => (
        <video
          class={`demo__video demo__video--${theme}`}
          data-theme-video={theme}
          data-src={video[theme].src}
          data-poster={video[theme].poster}
          width={video.width}
          height={video.height}
          aria-label={video.alt}
          muted
          loop
          playsinline
          disablepictureinpicture
          preload="none"
        />
      ))}
      <noscript>
        <video
          class="demo__video"
          src={video.dark.src}
          poster={video.dark.poster}
          width={video.width}
          height={video.height}
          aria-label={video.alt}
          controls
          muted
          loop
          playsinline
          preload="none"
        />
      </noscript>
    </figure>
  ) : (
    project.image && (
      <figure class="flagship__media">
        <img
          src={project.image.src}
          alt={project.image.alt}
          width={project.image.width}
          height={project.image.height}
          loading="lazy"
          decoding="async"
        />
      </figure>
    )
  )}
</article>

<script>
  import '@/scripts/demo';
</script>
