---
// Inline SVG icons, drawn for this site on a 24 px grid.
// The GitHub octocat and LinkedIn "in" shapes are cut from the official marks
// in Simple Icons (https://simpleicons.org, CC0 public domain: GitHub v16.33.0,
// LinkedIn v13.21.0) and set in thin outlined frames; no credit is required.
interface Props {
  name: keyof typeof icons;
  class?: string;
}

// An icon is an outline (`stroke`), a filled shape (`fill`), or both.
interface IconDef {
  stroke?: string;
  strokeWidth?: number;
  fill?: string;
  // Holes in `fill` are cut with the even-odd rule.
  evenOdd?: boolean;
  // Places `fill` inside the frame drawn by `stroke`.
  fillTransform?: string;
  color?: string;
}

const icons = {
  // A thin ring with the octocat: the circle plus Simple Icons' mark, filled
  // even-odd, leaves just the cat.
  github: {
    stroke: 'M23 12a11 11 0 1 1-22 0 11 11 0 1 1 22 0z',
    strokeWidth: 1.5,
    fill: 'M0 12.297a12 12 0 1 0 24 0 12 12 0 1 0-24 0zM12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
    evenOdd: true,
    fillTransform: 'translate(12 12) scale(.875) translate(-12 -12.297)',
  },
  // A thin rounded square with the "in" letters from Simple Icons' mark.
  linkedin: {
    stroke:
      'M4.75 1.75h14.5a3 3 0 0 1 3 3v14.5a3 3 0 0 1-3 3H4.75a3 3 0 0 1-3-3V4.75a3 3 0 0 1 3-3z',
    strokeWidth: 1.5,
    fill: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z',
    fillTransform: 'translate(12 12) scale(.86) translate(-11.86 -11.88)',
  },
  // A paper plane: the body, its centre fold and the tail flap.
  email: {
    stroke:
      'M22.5 1.5L1.5 11l7.3 3.7L22.5 1.5l-3.8 20.2-9.9-7M8.8 14.7v6.5l3.6-3.8',
    strokeWidth: 1.5,
  },
  // A page with a folded corner and lines of text.
  resume: {
    stroke:
      'M6.5 3H14l4.5 4.5V20a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4.5h4.5M8.5 9h3M8.5 12.5h7M8.5 16h7',
  },
  // A sun: a disc with eight rays.
  sun: {
    stroke:
      'M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0zM12 2.5V5M12 19v2.5M2.5 12H5M19 12h2.5M5.28 5.28l1.77 1.77M16.95 16.95l1.77 1.77M16.95 7.05l1.77-1.77M5.28 18.72l1.77-1.77',
    color: '#FF8C00',
  },
  // A crescent: a 9 px circle with a 7.5 px circle cut from its top right.
  moon: {
    fill: 'M10.59 3.11A9 9 0 1 0 20.89 13.41 7.5 7.5 0 0 1 10.59 3.11z',
    color: '#F1C40F',
  },
  star: {
    stroke:
      'M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z',
  },
  download: {
    stroke: 'M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19.5h14',
  },
  arrow: {
    stroke: 'M5 12h14m0 0l-5.5-5.5M19 12l-5.5 5.5',
  },
  external: {
    stroke: 'M14 5h5v5m0-5l-8 8M18 14v5H5V6h5',
  },
  rss: {
    stroke: 'M5 5a14 14 0 0114 14M5 11a8 8 0 018 8M6 19h.01',
  },
} satisfies Record<string, IconDef>;

const { name, class: className } = Astro.props;
const icon: IconDef = icons[name];
const color = icon.color ?? 'currentColor';
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  {icon.stroke && (
    <path
      fill="none"
      stroke={color}
      stroke-width={icon.strokeWidth ?? 1.75}
      stroke-linecap="round"
      stroke-linejoin="round"
      d={icon.stroke}
    />
  )}
  {icon.fill && (
    <path
      fill={color}
      fill-rule={icon.evenOdd ? 'evenodd' : undefined}
      transform={icon.fillTransform}
      d={icon.fill}
    />
  )}
</svg>
