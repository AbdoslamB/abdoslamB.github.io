---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { site } from '@/config/site';
import { getPosts, showWriting } from '@/lib/posts';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const posts = await getPosts();

// On the home page links jump within the page; elsewhere they go home first.
const prefix = isHome ? '' : '/';
const sections = [
  { id: 'about', label: 'About' },
  { id: 'projects', label: 'Projects' },
  ...(showWriting(posts) ? [{ id: 'writing', label: 'Writing' }] : []),
  { id: 'contact', label: 'Contact' },
];
// Logo: lowercase initials followed by a rainbow dot ("ab.").
const initials = site.name
  .split(' ')
  .map((part) => part[0])
  .join('')
  .toLowerCase();
---

<header class="site-header" data-state={isHome ? 'hero' : 'solid'}>
  <div class="site-header__backdrop" aria-hidden="true">
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
  </div>
  <nav class="site-header__nav" aria-label="Main">
    <a
      class="site-header__logo"
      href={isHome ? '#top' : '/'}
      data-jump={isHome ? 'top' : undefined}
      aria-label={`${site.name}, home`}
    >
      {initials}
      <span class="site-header__logo-dot" aria-hidden="true"></span>
    </a>
    <ul class="site-header__links">
      {sections.map(({ id, label }) => (
        <li>
          <a href={`${prefix}#${id}`} data-jump={isHome ? id : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <ThemeToggle />
</header>

<script>
  // On non-hero pages (where home.ts is not active), handle scroll show/hide
  const track = document.querySelector('[data-hero-track]');
  const header = document.querySelector<HTMLElement>('.site-header');

  if (header && !track) {
    let lastScrollY = window.scrollY;
    let ticking = false;
    const SCROLL_DELTA = 8;

    const updateHeader = () => {
      const currentScrollY = Math.max(0, window.scrollY);
      const diff = currentScrollY - lastScrollY;

      if (diff > SCROLL_DELTA && currentScrollY > 60) {
        header.dataset.state = 'hidden';
      } else if (diff < -SCROLL_DELTA || currentScrollY <= 20) {
        header.dataset.state = 'solid';
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHeader);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>
