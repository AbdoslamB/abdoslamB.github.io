---
import Flagship from '@/components/Flagship.astro';
import Hero from '@/components/Hero.astro';
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { featured, flagship, hiddenRepos, moreCount } from '@/config/projects';
import { links, site } from '@/config/site';
import github from '@/data/github.json';
import Base from '@/layouts/Base.astro';
import { homepagePosts } from '@/lib/featured';
import { getPosts, showWriting } from '@/lib/posts';
import {
  formatCount,
  type GitHubSnapshot,
  moreRepos,
  showStars,
  withStats,
} from '@/lib/projects';

const snapshot = github as GitHubSnapshot;
const flagshipView = withStats(flagship, snapshot, links.github);
const projects = featured.map((project) =>
  withStats(project, snapshot, links.github),
);
const more = moreRepos(
  snapshot,
  [flagship.repo, ...featured.map(({ repo }) => repo), ...hiddenRepos],
  moreCount,
);

const posts = await getPosts();
const hasWriting = showWriting(posts);

const sections = [
  { id: 'about', label: 'About' },
  { id: 'projects', label: 'Projects' },
  ...(hasWriting ? [{ id: 'writing', label: 'Writing' }] : []),
  { id: 'contact', label: 'Contact' },
];
---

<Base isHome>
  <Hero sections={sections} />

  <main id="main">
    <section id="about" class="section" aria-labelledby="about-heading">
      <div class="container about">
        <div class="about__text">
          <h2
            id="about-heading"
            class="section__heading"
            data-section-heading
            tabindex="-1"
          >
            About
          </h2>
          <!-- Draft copy: edit freely. -->
          <p class="lead">
            I’m a data scientist who cares most about simplicity and
            optimisation: finding the cleanest, most efficient path from a messy
            problem to an answer people can trust.
          </p>
          <p>
            Day to day, I shape ideas into features for platforms that handle
            high-volume financial data, working in R, Python and SQL, from
            forecasting to machine learning. I also design the prompts that
            guide AI agents through pipeline work. Outside work, I learn by
            building: my latest project is{' '}
            <a href="#projects" data-jump="projects">
              InkDoc
            </a>
            , an open-source app that converts documents into clean Markdown for
            LLM and RAG pipelines. One rule runs through all of it: if it can’t
            be reconciled, it isn’t done.
          </p>
        </div>
        {site.headshot && (
          <img
            class="about__photo"
            src={site.headshot}
            alt={site.name}
            width="320"
            height="320"
            loading="lazy"
          />
        )}
      </div>
    </section>

    <section id="projects" class="section" aria-labelledby="projects-heading">
      <div class="container">
        <h2
          id="projects-heading"
          class="section__heading"
          data-section-heading
          tabindex="-1"
        >
          Projects
        </h2>
        <p class="section__intro">All open source — code on GitHub.</p>
        <Flagship project={flagshipView} />
        <div class="grid">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
        {more.length > 0 && (
          <div class="more">
            <h3 class="more__heading">More on GitHub</h3>
            <ul class="more__list">
              {more.map((repo) => (
                <li>
                  <a href={repo.url} rel="noopener">
                    {repo.name}
                  </a>
                  {repo.description && <span> — {repo.description}</span>}
                  {showStars(repo.stars) && (
                    <span class="more__stars">
                      <Icon name="star" /> {formatCount(repo.stars)}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
        <p class="section__more">
          <a
            class="text-link"
            href={`${links.github}?tab=repositories`}
            rel="noopener"
          >
            All repositories on GitHub <Icon name="arrow" />
          </a>
        </p>
      </div>
    </section>

    {hasWriting && (
      <section id="writing" class="section" aria-labelledby="writing-heading">
        <div class="container">
          <h2
            id="writing-heading"
            class="section__heading"
            data-section-heading
            tabindex="-1"
          >
            Writing
          </h2>
          <div class="grid">
            {homepagePosts(posts).map((post) => (
              <PostCard post={post} />
            ))}
          </div>
          <p class="section__more">
            <a class="text-link" href="/writing/">
              All posts <Icon name="arrow" />
            </a>
            <a class="text-link" href="/rss.xml">
              <Icon name="rss" /> RSS
            </a>
          </p>
        </div>
      </section>
    )}

    <section
      id="contact"
      class="section section--contact"
      aria-labelledby="contact-heading"
    >
      <div class="container contact">
        <h2
          id="contact-heading"
          class="section__heading"
          data-section-heading
          tabindex="-1"
        >
          Get in touch
        </h2>
        <p class="lead">
          The quickest way to reach me is email. I’m also on LinkedIn and
          GitHub.
        </p>
        <div class="contact__actions">
          <a class="button button--primary" href={`mailto:${links.email}`}>
            <Icon name="email" /> Email me
          </a>
          <a class="button" href={links.linkedin} rel="noopener">
            <Icon name="linkedin" /> LinkedIn
          </a>
          <a class="button" href={links.github} rel="noopener">
            <Icon name="github" /> GitHub
          </a>
          {links.resume && (
            <a class="button" href={links.resume} rel="noopener">
              <Icon name="resume" /> Resume
            </a>
          )}
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import '@/scripts/home';
</script>
