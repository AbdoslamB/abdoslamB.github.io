{
  "name": "abdoslamb.github.io",
  "private": true,
  "type": "module",
  "homepage": "https://abdoslamb.github.io/",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "github": "node scripts/fetch-github.mjs",
    "favicon": "node scripts/make-favicon.mjs",
    "prebuild": "npm run github",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "prelint": "astro sync",
    "lint": "eslint --cache --max-warnings 0 . && stylelint --max-warnings 0 \"src/**/*.scss\"",
    "format": "prettier --cache --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-perfectionist": "^5.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sass": "^1.107.1",
    "satori": "0.35.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
