{
  "name": "abdoslamb.github.io",
  "private": true,
  "type": "module",
  "homepage": "https://abdoslamb.github.io/",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "github": "node scripts/fetch-github.mjs",
    "favicon": "node scripts/make-favicon.mjs",
    "prebuild": "npm run github",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint --cache --max-warnings 0 . && stylelint --max-warnings 0 \"src/**/*.scss\"",
    "format": "prettier --cache --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sass": "^1.105.1",
    "satori": "^0.35.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
